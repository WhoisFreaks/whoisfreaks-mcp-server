# Written by ansible/setup.yml: the WhoisFreaks MCP server in hosted HTTP mode. It keeps no API key of
# its own (every request carries the caller's, or signs in with OAuth), so there is no secret here.
# OAuth sign-in's settings, BILLING_SERVER_TOKEN among them, are in {{ oauth_env_file }}, which only root
# can read and which exists only while OAuth is on ("-": no file, no OAuth).
[Unit]
Description=WhoisFreaks MCP server (Streamable HTTP on port {{ app_port }})
After=network-online.target
Wants=network-online.target

[Service]
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}
Environment="PORT={{ app_port }}"
EnvironmentFile=-{{ oauth_env_file }}
ExecStart=/usr/bin/java {{ app_java_opts }} -jar {{ app_jar }} --http
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
