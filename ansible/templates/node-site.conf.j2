{# setup.yml: a site, one for each server in app_instances. Before the machine has a certificate for
   it, only the port 80 block, so Let's Encrypt can check the name. #}
# {{ instance.hostname }}: {{ instance.what }} on this machine (port {{ instance.port }}). Written by ansible/setup.yml.
{% if node_has_cert | bool %}
server {
    server_name {{ instance.hostname }};
    include /etc/nginx/cloudflare-realip.conf;
    include /etc/nginx/mcp-logging.conf;

    # A JSON-RPC request is small; the server itself refuses bodies over 1 MB.
    client_max_body_size 1m;

    location / {
        limit_req zone=mcp burst={{ nginx_rate_burst }} nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:{{ instance.port }};
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        # Answers go out as the server produces them.
        proxy_buffering off;
        # Bulk lookups and domain typosquatting searches can take a few minutes; nginx's default is 60s.
        proxy_read_timeout 300s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/{{ instance.hostname }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ instance.hostname }}/privkey.pem; # managed by Certbot
{% if certbot_options | bool %}
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
{% endif %}
{% if certbot_dhparam | bool %}
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
{% endif %}

}

server {
    if ($host = {{ instance.hostname }}) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name {{ instance.hostname }};
    include /etc/nginx/cloudflare-realip.conf;
    include /etc/nginx/mcp-logging.conf;
    listen 80;
    return 404; # managed by Certbot


}
{%- else %}
server {
    server_name {{ instance.hostname }};
    include /etc/nginx/cloudflare-realip.conf;
    include /etc/nginx/mcp-logging.conf;
    listen 80;
    return 404;
}
{% endif %}
