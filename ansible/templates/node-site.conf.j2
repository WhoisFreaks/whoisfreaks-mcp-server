{# setup.yml: the site. Before the machine has a certificate, only the port 80 block, so
   Let's Encrypt can check the name. #}
# {{ mcp_hostname }}: the WhoisFreaks MCP server on this machine (port {{ app_port }}). Written by ansible/setup.yml.
{% if node_has_cert | bool %}
server {
    server_name {{ mcp_hostname }};
    include /etc/nginx/cloudflare-realip.conf;
    include /etc/nginx/mcp-logging.conf;

    # A JSON-RPC request is small; the server itself refuses bodies over 1 MB.
    client_max_body_size 1m;

    location / {
        limit_req zone=mcp burst={{ nginx_rate_burst }} nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        # Answers go out as the server produces them.
        proxy_buffering off;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/{{ mcp_hostname }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ mcp_hostname }}/privkey.pem; # managed by Certbot
{% if certbot_options | bool %}
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
{% endif %}
{% if certbot_dhparam | bool %}
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
{% endif %}

}

server {
    if ($host = {{ mcp_hostname }}) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name {{ mcp_hostname }};
    include /etc/nginx/cloudflare-realip.conf;
    include /etc/nginx/mcp-logging.conf;
    listen 80;
    return 404; # managed by Certbot


}
{%- else %}
server {
    server_name {{ mcp_hostname }};
    include /etc/nginx/cloudflare-realip.conf;
    include /etc/nginx/mcp-logging.conf;
    listen 80;
    return 404;
}
{% endif %}
