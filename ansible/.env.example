# Settings for the Ansible playbooks in this folder. Copy this file to .env and fill it in; git
# ignores .env. One NAME=value per line, quotes optional. Put comments on their own lines: anything
# after the "=" is part of the value. An empty value falls back to an environment variable of the
# same name. A playbook stops before doing anything if a setting it needs is missing, and names it.

# ---- The server (required by every playbook) ----

# The machine's public IPv4 address.
MCP_SERVER_IP=

# The address users connect to (https://<MCP_HOSTNAME>/mcp), e.g. mcp.example.com. nginx serves it
# and its Let's Encrypt certificate is for it. It must point at MCP_SERVER_IP.
MCP_HOSTNAME=

# ---- Optional ----

# The user Ansible logs in as. setup.yml creates it on the machine (passwordless sudo, your SSH key).
# Empty: mcp.
MCP_SERVER_USER=

# Cloudflare API token that creates the DNS record MCP_HOSTNAME -> MCP_SERVER_IP: needs
# "Zone: DNS - Edit" and "Zone: Zone - Read" on the zone. setup.yml only. Empty: setup.yml doesn't
# touch DNS, and the record must exist before you run it.
CF_DNS_API_TOKEN=

# The Cloudflare zone MCP_HOSTNAME is in, when CF_DNS_API_TOKEN is set. Empty: the hostname's last
# two labels (mcp.example.com -> example.com).
CF_ZONE=

# The git user and access token the server pulls and clones the code with (read access to
# whoisfreaks-mcp-server). Leave both empty while the repository is public.
GIT_USERNAME=
GIT_TOKEN=

# IPs nginx refuses, comma-separated. setup.yml only.
NGINX_DENIED_IPS=
