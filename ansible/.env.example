# Settings for the Ansible playbooks in this folder. Copy this file to .env and fill it in; git
# ignores .env. One NAME=value per line, quotes optional. Put comments on their own lines: anything
# after the "=" is part of the value. An empty value falls back to an environment variable of the
# same name. A playbook stops before doing anything if a setting it needs is missing, and names it.

# ---- The server (required by every playbook) ----

# The machine's public IPv4 address.
MCP_SERVER_IP=

# The address users connect to (https://<MCP_HOSTNAME>), e.g. mcp.example.com. nginx serves it
# and its Let's Encrypt certificate is for it. It must point at MCP_SERVER_IP.
MCP_HOSTNAME=

# ---- Optional ----

# The user Ansible logs in as. The first setup.yml run logs in as root, creates this user
# (passwordless sudo, your SSH key) and then blocks root logins; every later run logs in as this user.
# Empty: mcp.
MCP_SERVER_USER=

# Cloudflare API token that creates the DNS record MCP_HOSTNAME -> MCP_SERVER_IP: needs
# "Zone: DNS - Edit" and "Zone: Zone - Read" on the zone. setup.yml only. Empty: setup.yml doesn't
# touch DNS, and the record must exist before you run it.
CF_DNS_API_TOKEN=

# The Cloudflare zone MCP_HOSTNAME is in, when CF_DNS_API_TOKEN is set: its name (example.com) or its
# Zone ID (32 characters, on the zone's overview page). Empty: the hostname's last two labels
# (mcp.example.com -> example.com).
CF_ZONE=

# The git user and access token the server pulls and clones the code with (read access to
# whoisfreaks-mcp-server). Leave both empty while the repository is public.
GIT_USERNAME=
GIT_TOKEN=

# IPs nginx refuses, comma-separated. setup.yml only.
NGINX_DENIED_IPS=

# ---- OAuth sign-in (optional) ----
# Lets users sign in with OAuth instead of sending an API key, as the WhoisFreaks plugin in ChatGPT and
# Codex does, at the same address. API keys keep working. Setting OAUTH_ISSUER turns it on and needs the
# other two; leaving it empty turns it off (setup.yml removes the settings).

# The authorization server that signs users in (WhoisFreaks billing's issuer), e.g. https://auth.example.com.
OAUTH_ISSUER=

# Billing's backend, where the server trades access tokens for API keys, e.g. https://billing-backend.example.com.
BILLING_URL=

# Secret shared with billing for that trade (billing's oauth.mcp-server-token). Letters and digits only,
# e.g. from "openssl rand -hex 32": it goes unquoted into a systemd environment file.
BILLING_SERVER_TOKEN=

# ---- OpenAI domain verification (optional) ----
# The token OpenAI's plugin portal shows when you connect the server (Plugins -> MCPs -> Connect). With it
# set, nginx answers https://<MCP_HOSTNAME>/.well-known/openai-apps-challenge with exactly this token. Run
# "ansible-playbook setup.yml --tags nginx" after changing it (README.md, "OpenAI domain verification").
OPENAI_APPS_CHALLENGE=
